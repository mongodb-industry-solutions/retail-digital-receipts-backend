# MongoDB connection URI 
# Example: mongodb+srv://<user>:<password>@<cluster-url>/
MONGODB_URI="your_mongodb_uri_here"

# Name of the database where orders and invoices are stored
DATABASE_NAME="your_database_name_here"

# Azure Blob Storage connection string (for storing invoice files)
# You can get this from your Azure Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING="your_azure_storage_connection_string_here"

# Name of the Azure Blob Storage container where invoice files will be stored
AZURE_BLOB_CONTAINER_NAME="your_blob_container_name_here"

# CORS: Origins allowed to access this backend (e.g., frontend dev URL)
# Use http://localhost:3000 when running locally
ORIGINS="http://localhost:3000"

# Endpoint of the Azure Function that enriches invoice metadata
# This function simulates integration with an external service
AZURE_METADATA_ENDPOINT="https://your-azure-function-url/api/invoiceEnrichmentMock"
