# MongoDB Atlas.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/
MONGODB_URI=<YOUR_MONGODB_URI>
# Logical database that stores invoices, orders, users, etc.
DATABASE_NAME=leafy_popup_store
# Azure Blob Storage  (Managed Identity – no connection string needed)
# Public‑DNS-style account URL.  Format:
# https://<storage-account-name>.blob.core.windows.net/
AZURE_BLOB_ACCOUNT_URL=https://<YOUR_ACCOUNT>.blob.core.windows.net/
# Container that holds the rendered PDF files
AZURE_BLOB_CONTAINER_NAME=retail-invoices
# Invoice‑enrichment mock (Azure Function)
# Endpoint that injects extra metadata into invoices (ERP / tax info)
AZURE_METADATA_ENDPOINT=https://<YOUR_FUNCTION_APP>.azurewebsites.net/api/invoiceEnrichmentMock
# CORS
# Whitelisted origins for the API (comma‑separated)
ORIGINS=http://localhost:3000
