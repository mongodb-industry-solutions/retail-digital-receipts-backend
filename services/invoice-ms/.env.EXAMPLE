# MongoDB connection URI 
MONGODB_URI="your_mongodb_uri_here"

# Name of the database where orders and invoices are stored
DATABASE_NAME="your_database_name_here"

# Azure Blob Storage connection string (optional for invoice assets)
AZURE_STORAGE_CONNECTION_STRING="your_connection_string_here"

# CORS: Origins allowed to access this backend (e.g. local frontend dev URL)
ORIGINS="http://localhost:3000"

# Endpoint of the Azure Function that enriches invoice metadata
AZURE_METADATA_ENDPOINT="https://your-azure-function-url"
